# Copy to .env.local for the Next.js app. Prisma CLI also reads .env.
# Never commit real secrets. Do not prefix any secret with NEXT_PUBLIC_.

# Local demo database. Use libsql://... when connecting to Turso.
DATABASE_URL="file:./dev.db"

# Required only for a remote Turso database. Leave empty for the local file.
TURSO_AUTH_TOKEN=

# Primary analyzer. Used when DEMO_MODE=false, or when DEMO_MODE=true and this key is set.
XAI_API_KEY=
XAI_MODEL=grok-4

# Optional secondary analyzer. Not called unless AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Gmail OAuth. Leave empty to use the synthetic mailbox.
# Scope is fixed to https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/gmail/callback
GOOGLE_REFRESH_TOKEN=

# grok | gemini | mock
# With DEMO_MODE=true and no key for the selected provider, the mock analyzer is used.
AI_PROVIDER=grok

# Required for unauthenticated local use. Set to false only after authentication exists.
DEMO_MODE=true
